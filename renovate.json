{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>inseven/renovate-config"
  ],
  "cloneSubmodules": true,
  "cloneSubmodulesFilter": ["docs/_theme"],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["imagemagick"],
      "packageName": "conda-forge/imagemagick"
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "keyboard/keebio-components",
        "keyboard/Keebio-Parts.pretty",
        "keyboard/marbastlib"
      ],
      "enabled": false
    }
  ]
}
